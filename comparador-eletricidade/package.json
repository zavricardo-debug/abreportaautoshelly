{
  "name": "comparador-eletricidade",
  "version": "1.0.0",
  "description": "Carregue a sua fatura de eletricidade (PDF) e compare com todas as ofertas do mercado português (dados ERSE).",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "vendor": "node scripts/vendor-pdfjs.mjs",
    "data:build": "node scripts/update-erse.mjs --csv-dir ./data-src",
    "data:update": "node scripts/update-erse.mjs",
    "samples": "node scripts/make-sample-pdf.mjs",
    "build": "node scripts/build-dist.mjs",
    "pdf:text": "node scripts/pdf-to-text.mjs",
    "test": "node --test test/*.test.mjs",
    "data:cnmc": "node scripts/update-cnmc.mjs",
    "data:check-es": "node --input-type=module -e \"import('./public/lib/simulator-es.js').then(async(m)=>{const ds=JSON.parse((await import('node:fs')).readFileSync('public/data/ofertas-es.json','utf8'));const p={days:31,power:{p1:4.6,p2:4.6},kwh:m.splitConsumption(277.224,{punta:97,llano:60,valle:119})};for(const r of m.simulateAllES(ds,p))console.log(r.sim.total.toFixed(2).padStart(7),r.offer.supplier,'–',r.offer.name)})\"",
    "samples:curve": "node scripts/make-sample-curve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "^0.17.0"
  }
}
