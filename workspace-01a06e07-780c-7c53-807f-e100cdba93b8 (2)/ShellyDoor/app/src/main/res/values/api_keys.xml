<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Maps API key para o seletor de mapa.
    1. Vai a https://console.cloud.google.com/google/maps-apis
    2. Cria (ou usa) uma chave, ativa a "Maps SDK for Android".
    3. Cola-a aqui dentro das aspas (mantém o xml escapado — &amp; para &).
    Se deixares vazio, o resto da app funciona; só o mapa fica sem fundo.
-->
<resources>
    <string name="google_maps_api_key">YOUR_GOOGLE_MAPS_API_KEY</string>
</resources>
