<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rede / Shelly -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Localização: necessária para o geofencing da porta e para ler o SSID do Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Sem esta, os geofences e o rastreio param quando a app não está aberta -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Notificações (botão manual "Abrir porta") -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Serviço em foreground (para geofencing fiável em background) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Re-armar os geofences após reiniciar o telemóvel -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Pedir isenção da otimização de bateria (senão o Android mata o rastreio) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- O geofencing precisa do Google Play Services / GPS -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ShellyDoor">

        <!-- Google Maps API key. Edita app/src/main/res/values/api_keys.xml -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_api_key" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GlobalSettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="Definições globais" />

        <activity
            android:name=".DoorSettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="Morada" />

        <activity
            android:name=".DoorDiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="Porque é que não abre?" />

        <activity
            android:name=".MapsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="Marcar no mapa" />

        <!-- Recetor de eventos de geofence -->
        <receiver
            android:name=".DoorGeofenceReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.example.shellydoor.GEOFENCE" />
            </intent-filter>
        </receiver>

        <!-- Recetor do botão manual "Abrir porta" das notificações.
             FALTAVA no manifest: sem esta declaração o Android nunca entregava
             o broadcast e o botão da notificação não fazia absolutamente nada. -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.shellydoor.OPEN_MANUAL" />
            </intent-filter>
        </receiver>

        <!-- Recetor de arranque do sistema -->
        <!-- BOOT_COMPLETED é entregue pelo sistema: o recetor TEM de ser exported
             (com exported="false" o Android nunca o acordava depois de reiniciar). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Serviço em foreground -->
        <service
            android:name=".DoorService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
